#!/sbin/sh
# JunkClean Magisk/KSU/APatch 通用安装脚本（自包含，不依赖 Magisk 环境）
umask 022
OUTFD=$2
ZIPFILE=$3
MODPATH=/data/adb/modules/junkclean
ui_print() {
  echo "ui_print $1" >&$OUTFD
  echo "ui_print" >&$OUTFD
}
set_perm_recursive() { # dir owner group dperm fperm
  chown -R "$2:$3" "$1" 2>/dev/null
  find "$1" -type d -exec chmod "$4" {} + 2>/dev/null
  find "$1" -type f -exec chmod "$5" {} + 2>/dev/null
}
ui_print "📦 Installing JunkClean v3.0"
rm -rf "$MODPATH"
mkdir -p "$MODPATH"
# unzip 可能缺失，回退 busybox unzip
if ! unzip -o "$ZIPFILE" -d "$MODPATH" >&2 2>/dev/null; then
  busybox unzip -o "$ZIPFILE" -d "$MODPATH" >&2
fi
set_perm_recursive "$MODPATH" 0 0 0755 0644
set_perm_recursive "$MODPATH/system/bin" 0 0 0755 0755
ui_print "✅ Done"
exit 0

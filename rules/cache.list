# 应用缓存（删除后自动重建，安全）
/data/data/*/cache/*
/data/data/*/code_cache/*
/data/user/*/cache/*
/data/user_de/*/cache/*
/sdcard/Android/data/*/cache/*
/data/user_de/*/*/cache/*
# --- 广告 SDK 残留（通配任意包，删除安全）---
/sdcard/Android/data/*/files/ad_cache/*
/sdcard/Android/data/*/files/unity_ad/*
/sdcard/Android/data/*/files/unityads/*
/sdcard/Android/data/*/files/unity_ads_cache/*
/sdcard/Android/data/*/files/GDT_AD/*
/sdcard/Android/data/*/files/GDT_CACHE/*
/sdcard/Android/data/*/files/pangle_com/*
/sdcard/Android/data/*/files/ksad_cache/*
/sdcard/Android/data/*/files/tt_ad/*
# --- 常用 App 缓存（参考 Ghost Cleaner 规则库扩充）---
/sdcard/Douyin/cache/*
/sdcard/gifshow/cache/*
/sdcard/netease/cloudmusic/Cache/*
/sdcard/netease/cloudmusic/Ad/*
